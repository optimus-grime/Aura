{
  "entities": {
    "Report": {
      "title": "Saved Report",
      "description": "A saved personality analysis report along with traits.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Auth ID of the user who owns this report"
        },
        "date": {
          "type": "string"
        },
        "report": {
          "type": "object",
          "properties": {
            "mbti": { "type": "string" },
            "bigFive": { "type": "object" },
            "summary": { "type": "string" }
          }
        },
        "createdAt": {
          "type": "number",
          "description": "Server timestamp of creation"
        }
      },
      "required": ["userId", "date", "report", "createdAt"]
    },
    "SyncCurrent": {
      "title": "Current Sync Metrics",
      "description": "Normalized latest biometric and report metrics for sync bridge",
      "type": "object",
      "properties": {
        "readinessScore": { "type": "number" },
        "hrvBalanceMs": { "type": "number" },
        "sleepHours": { "type": "number" },
        "restingHeartRateBpm": { "type": "number" },
        "statusLabel": { "type": "string" },
        "lastSyncedAt": { "type": "number" }
      },
      "required": ["readinessScore", "hrvBalanceMs", "sleepHours", "restingHeartRateBpm", "statusLabel", "lastSyncedAt"]
    }
  },
  "firestore": {
    "users/{userId}/reports/{reportId}": {
      "schema": "Report",
      "description": "User's individual reports"
    },
    "users/{userId}/sync/current": {
      "schema": "SyncCurrent",
      "description": "Latest synced biometric metrics for user"
    }
  }
}
