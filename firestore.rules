rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Project Helpers
    function isValidReport(data) {
      return data.keys().hasAll(['userId', 'date', 'report']) &&
             data.userId == request.auth.uid &&
             data.date is string &&
             data.date.size() <= 50 &&
             data.report is map;
    }

    function isValidSyncCurrent(data) {
      return data.keys().hasAll(['readinessScore', 'hrvBalanceMs', 'sleepHours', 'restingHeartRateBpm', 'statusLabel', 'lastSyncedAt']) &&
             data.keys().size() == 6 &&
             data.readinessScore is number &&
             data.hrvBalanceMs is number &&
             data.sleepHours is number &&
             data.restingHeartRateBpm is number &&
             data.statusLabel is string &&
             data.statusLabel.size() <= 100 &&
             data.lastSyncedAt == request.time;
    }

    // Reports matching
    match /users/{userId}/reports/{reportId} {
      // Security Constraints:
      // - Only the owner can manage their reports
      allow get: if isSignedIn() && isValidId(userId) && isValidId(reportId) && userId == request.auth.uid;
      
      allow list: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(userId) && isValidId(reportId) &&
                    userId == request.auth.uid &&
                    isValidReport(incoming());
                    
      allow delete: if isSignedIn() && isValidId(userId) && isValidId(reportId) &&
                    userId == request.auth.uid;
                    
      allow update: if false; // Reports are immutable once generated
    }

    // Sync current metrics matching
    match /users/{userId}/sync/current {
      allow get, list: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow create, update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid &&
                            isValidSyncCurrent(incoming());
      allow delete: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
    }
  }
}
